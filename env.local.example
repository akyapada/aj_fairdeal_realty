# Copy this file to `.env.local` (same folder) and fill in both values.
#
# Where to find them:
#   Supabase dashboard → your project → Settings → API
#
# `.env.local` must NEVER be committed to git. The .gitignore that
# create-next-app generates already excludes it — leave that alone.
#
# Only add keys here that are safe to expose in a browser. Anything
# prefixed NEXT_PUBLIC_ is shipped to every visitor's browser, by design.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-the-anon-public-key-here

# Your WhatsApp number in international format, no + and no spaces.
# Example for +91 98765 43210 → 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX

# Your TG-RERA agent registration number, once it comes through.
# This gets displayed in the site footer.
NEXT_PUBLIC_RERA_AGENT_NUMBER=

# Analytics (step 10). Each is optional — leave any of these blank and
# that tracker just won't load; nothing else breaks.
#   PostHog:  posthog.com → your project → Project Settings → Project API Key / Host
#   GA4:      analytics.google.com → Admin → Data Streams → your stream → Measurement ID
#   Clarity:  clarity.microsoft.com → your project → Settings → Setup → Project ID
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ---------------------------------------------------------------------
# DO NOT put the service_role key in this file or anywhere in this
# project. It bypasses Row Level Security completely. If it reaches
# the browser, your entire leads table is public.
# ---------------------------------------------------------------------
